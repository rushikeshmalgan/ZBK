# Copy to `.streamlit/secrets.toml` (git-ignored) for local use, or paste these
# into the "Secrets" box of your Streamlit Community Cloud app.
# The app works without this; it only enables the AI Scout features.

GEMINI_API_KEY = "your_api_key_here"
# optional — defaults to gemini-2.5-flash
GEMINI_MODEL = "gemini-2.5-flash"
