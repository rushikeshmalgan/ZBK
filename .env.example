# Copy to `.env` (git-ignored) OR set these as real environment variables.
# The AI Scout features stay disabled until GEMINI_API_KEY is set; the rest of the app works without it.
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your_api_key_here
# optional — defaults to a cost-efficient Flash model
GEMINI_MODEL=gemini-2.5-flash
